# context is the root of the project
# /projects/nopCommerce
# this devcontainer dockerfile in the ./.devcontainer folder

# create the build instance 
FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS build
# add vscode user
RUN adduser -D vscode

# Temporarily copy the src directory for the build process
USER root
WORKDIR /nop

# Ensure correct ownership and permissions for the ./src directory
COPY ./src ./src/
RUN chown -R vscode:vscode ./src
RUN chmod -R 775 ./src

# Ensure the /app/published directory exists and has the correct permissions
RUN mkdir -p /app && chmod -R 775 /app && chown -R vscode:vscode /app
RUN mkdir -p /app/published && chmod -R 775 /app/published
RUN chown -R vscode:vscode /app

# Install dos2unix to ensure proper line endings
RUN apk add --no-cache dos2unix
# Copy entrypoint script
COPY ./entrypoint.sh /entrypoint.sh

# Convert line endings to LF and set correct permissions
RUN dos2unix /entrypoint.sh && chmod 755 /entrypoint.sh && chown -R vscode:vscode /entrypoint.sh

# Switch to non-root user for the build process
USER vscode
WORKDIR /nop/src
RUN dotnet build NopCommerce.sln --no-incremental -c Debug

# publish project
WORKDIR /nop/src/Presentation/Nop.Web   
# Build and publish the application in Debug mode
RUN dotnet publish Nop.Web.csproj -c Debug -o /app/published
WORKDIR /nop/app/published
RUN mkdir logs bin
RUN chmod 775 .

# Remove the temporary src directory to avoid conflicts with the mounted volume
#USER root
WORKDIR /nop
RUN rm -rf /src

# create the runtime instance 
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS runtime 

# Add the vscode user in the runtime stage
RUN adduser -D vscode

# Install Bash
RUN apk add --no-cache bash

# add globalization support
RUN apk add --no-cache icu-libs icu-data-full
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# installs required packages
RUN apk add tiff --no-cache --repository http://dl-3.alpinelinux.org/alpine/edge/main/ --allow-untrusted
RUN apk add libgdiplus --no-cache --repository http://dl-3.alpinelinux.org/alpine/edge/community/ --allow-untrusted
RUN apk add libc-dev tzdata --no-cache

WORKDIR /nop/app

COPY --from=build /app/published .

# Copy entrypoint script to the runtime container
COPY --from=build /entrypoint.sh /nop/entrypoint.sh

# Ensure correct ownership and permissions for the entrypoint script
RUN chown vscode:vscode /nop/entrypoint.sh && chmod 755 /nop/entrypoint.sh

# Ensure correct ownership and permissions for the runtime
RUN chown -R vscode:vscode /nop/app && chmod -R 775 /nop/app

# Switch to non-root user
USER vscode

ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

# Set Bash as the default shell
SHELL ["/bin/bash", "-c"]

ENTRYPOINT ["/nop/entrypoint.sh"]